CONFIG_MODULE_UNLOAD=y
CONFIG_MODULE_FORCE_UNLOAD=y
CONFIG_ARCH_MT8127_TANK=y
CONFIG_BCMDHD_USE_STATIC_BUF=y
CONFIG_RFKILL=y
CONFIG_ARCH_MTK_PROJECT="tank"
CONFIG_CUSTOM_KERNEL_IMGSENSOR="gc2355_mipi_raw gc2355_mipi_raw_qunhui gc0312_yuv hi704_yuv"
CONFIG_CUSTOM_KERNEL_LCM="hx8282_a01_lvds_dpi_vdo"
CONFIG_MTK_LCM_PHYSICAL_ROTATION="0"
# CONFIG_GPS is not set
# CONFIG_MTK_WIFI_MCC_SUPPORT is not set
# CONFIG_MTK_PMIC is not set
# CONFIG_MTK_PMIC_WRAP is not set
CONFIG_MTK_PMIC_DUMMY=y
CONFIG_MTK_SY8827_SUPPORT=y
# CONFIG_MTK_SOUND is not set
CONFIG_MTK_USBFSH=y
CONFIG_CMD_MODE_CHANGE=y
CONFIG_GPIO_USB_DEFAULT_DEVICE_MODE=y
CONFIG_MTK_DISABLE_POWER_ON_OFF_VOLTAGE_LIMITATION=y
CONFIG_MTK_HDMI_SUPPORT=y
CONFIG_MTK_AOSP_TVSTICK_SUPPORT=y
CONFIG_MTK_INTERNAL_HDMI_SUPPORT=y
CONFIG_MTK_HDMI_HDCP_SUPPORT=y
CONFIG_USB_NET_SMSC95XX=y
CONFIG_BCMDHD=m
CONFIG_I2C_CHARDEV=y
CONFIG_SND_DYNAMIC_MINORS=y
CONFIG_SND_SOC=y
CONFIG_HID_BATTERY_STRENGTH=y
CONFIG_BRCM_BT=y
CONFIG_SECURITY_PERF_EVENTS_RESTRICT=y
